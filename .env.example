NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
ANTHROPIC_API_KEY=            # required for AI drafts
CLAUDE_MODEL=claude-sonnet-5-5
# WhatsApp Cloud API - REQUIRES META CREDENTIALS, not wired to the UI yet
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
SUPABASE_SERVICE_ROLE_KEY=    # server-only; used ONLY by the WhatsApp webhook
WHATSAPP_APP_SECRET=          # Meta app secret; verifies webhook signatures
APP_TIMEZONE=UTC              # optional, e.g. Asia/Kolkata, for dashboard "today"
